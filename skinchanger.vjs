// =======================================================
// СКРИПТ: СКИНЧЕНДЖЕР И ПРАНКИ ЧЕРЕЗ ИГРОВЫЕ ПЛАШКИ (VSCRIPT)
// =======================================================

var currentMenu = "main";
var isAimEnabled = false;
var isWhEnabled = false;

// Функция вызывает сочные турнирные плашки по центру экрана
function ShowAlert(title, subtitle) {
    // ui_event 'show_survival_notice' выводит плашку в стиле разминки/опасной зоны
    SendToConsole("ui_event 'show_survival_notice' '" + title + "' '" + subtitle + "'");
}

// Показ текущего меню
function DrawMenu() {
    if (currentMenu === "main") {
        ShowAlert("=== ГЛАВНОЕ МЕНЮ ===", " [1] НОЖИ  |  [2] АГЕНТЫ  |  [3] ПРАНКИ");
    } else if (currentMenu === "knives") {
        ShowAlert("== СKИНЧЕНДЖЕР НОЖЕЙ ===", " [1] КЕРАМБИТ  |  [2] БАБОЧКА  |  [3] M9  |  [G] НАЗАД");
    } else if (currentMenu === "agents") {
        ShowAlert("=== ВЫБОР АГЕНТА ===", " [1] FBI  |  [2] SAS  |  [3] PHOENIX  |  [G] НАЗАД");
    } else if (currentMenu === "pranks") {
        var aimStatus = isAimEnabled ? "ВКЛ" : "ВЫКЛ";
        var whStatus = isWhEnabled ? "ВКЛ" : "ВЫКЛ";
        ShowAlert("=== ПРАНК ФУНКЦИИ ===", " [1] АИМ [" + aimStatus + "]  |  [2] ВХ [" + whStatus + "]  |  [G] НАЗАД");
    }
}

// Сюда будут прилетать команды из конфига при нажатии на кнопки 1, 2, 3
function MenuInput(buttonNumber) {
    if (currentMenu === "main") {
        if (buttonNumber === 1) { currentMenu = "knives"; }
        else if (buttonNumber === 2) { currentMenu = "agents"; }
        else if (buttonNumber === 3) { currentMenu = "pranks"; }
    } 
    else if (currentMenu === "knives") {
        if (buttonNumber === 1) { SendToConsole("slot3; drop; give weapon_knife_karambit"); }
        else if (buttonNumber === 2) { SendToConsole("slot3; drop; give weapon_knife_butterfly"); }
        else if (buttonNumber === 3) { SendToConsole("slot3; drop; give weapon_knife_m9_bayonet"); }
    } 
    else if (currentMenu === "agents") {
        if (buttonNumber === 1) { SendToConsole("sub_model models/player/custom_player/legacy/ctm_fbi_variantf.vmdl"); }
        if (buttonNumber === 2) { SendToConsole("sub_model models/player/custom_player/legacy/ctm_sas_variantf.vmdl"); }
        if (buttonNumber === 3) { SendToConsole("sub_model models/player/custom_player/legacy/tm_phoenix_varianti.vmdl"); }
    } 
    else if (currentMenu === "pranks") {
        if (buttonNumber === 1) {
            isAimEnabled = !isAimEnabled;
            if (isAimEnabled) { StartAimLoop(); }
        }
        else if (buttonNumber === 2) {
            isWhEnabled = !isWhEnabled;
            if (isWhEnabled) { SendToConsole("r_drawothermodels 2"); } 
            else { SendToConsole("r_drawothermodels 1"); }
        }
    }
    DrawMenu();
}

// Кнопка назад (вызывается из конфига при нажатии на G/drop)
function MenuBack() {
    if (currentMenu !== "main") {
        currentMenu = "main";
        DrawMenu();
    }
}

// Цикл для жесткого пранк-аима (притягивает ботов)
function StartAimLoop() {
    if (isAimEnabled) {
        SendToConsole("ent_teleport cs_bot");
        // Повторяем каждые 0.1 секунды
        DoUniqueStringTimeAsync(0.1, function() { StartAimLoop(); });
    }
}

// Выводим меню сразу при загрузке
DrawMenu();
